# Firebase web app config (Project settings > General > Your apps). Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# App Check. Firebase AI Logic requires it.
# Web: a reCAPTCHA Enterprise site key registered for your domain.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local dev and the Chrome extension: a debug token from the Firebase console.
# Keep it out of git. Revoke it after judging.
VITE_APPCHECK_DEBUG_TOKEN=
