# Firebase web app config (Project settings > General > Your apps). Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# App Check. Firebase AI Logic requires it.
# Hosted web app: the site key of a score based reCAPTCHA key from the same Google Cloud
# project, registered under App Check > Apps > Fraud Defense (reCAPTCHA Enterprise). Not secret.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Only for projects registered with the older reCAPTCHA v3 provider, which Firebase has
# switched off for new registrations.
VITE_RECAPTCHA_V3_KEY=
# Local dev and the Chrome extension: a debug token from the Firebase console.
# Keep it out of git. Leave it EMPTY when building the hosted site. Revoke it after judging.
VITE_APPCHECK_DEBUG_TOKEN=
