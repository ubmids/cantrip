rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared cantrips: anyone can install one by its code.
    // Only a signed-in (anonymous is fine) author can publish, never overwrite
    // someone else's, and documents stay small.
    match /shared/{code} {
      allow read: if code.matches('^[a-z0-9]{7}$');
      allow create: if request.auth != null
        && request.resource.data.author == request.auth.uid
        && request.resource.data.keys().hasOnly(['spec', 'tests', 'programs', 'author', 'createdAt', 'app'])
        && request.resource.data.tests.size() <= 60;
      allow update: if request.auth != null
        && resource.data.author == request.auth.uid
        && request.resource.data.author == request.auth.uid
        && request.resource.data.tests.size() <= 60;
      allow delete: if request.auth != null && resource.data.author == request.auth.uid;
    }
  }
}
